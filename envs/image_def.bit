FROM mambaorg/micromamba:2.5-ubuntu22.04

LABEL AUTHOR="Olabiyi Obayomi"
LABEL EMAIL="obadbotanist@yahoo.com"

COPY --chown=$MAMBA_USER:$MAMBA_USER bit.yaml /tmp/bit.yaml
RUN micromamba create -y -f /tmp/bit.yaml && \
    micromamba clean --all --yes

RUN echo "eval $(micromamba shell hook --shell bash) && micromamba activate && micromamba activate /opt/conda/envs/bit/" > ~/.bashrc

ENV PATH="/opt/conda/envs/bit/bin/:/opt/conda/bin:$PATH"

CMD ["/bin/bash"]