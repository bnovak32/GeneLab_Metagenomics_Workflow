FROM mambaorg/micromamba:2.5-ubuntu22.04

LABEL AUTHOR="Olabiyi Obayomi"
LABEL EMAIL="obadbotanist@yahoo.com"

COPY --chown=$MAMBA_USER:$MAMBA_USER keggdecoder.yaml /tmp/keggdecoder.yaml
RUN micromamba create -y -f /tmp/keggdecoder.yaml && \
    micromamba clean --all --yes

RUN echo "eval $(micromamba shell hook --shell bash) && micromamba activate && micromamba activate /opt/conda/envs/keggdecoder/" > ~/.bashrc

ENV PATH="/opt/conda/envs/keggdecoder/bin/:/opt/conda/bin:$PATH"

CMD ["/bin/bash"]
