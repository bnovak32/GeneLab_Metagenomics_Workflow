#!/usr/bin/env python

"""
This is a program for validating GeneLab pipeline processed metagenomics datasets.
It performs explicit validation for all expected files, structures, and sample content matches across:
1. Illumina Low Biomass (_GLlbsMetag)
2. Illumina Standard (_GLmetagenomics)
3. Nanopore Low Biomass (_GLlblMetag)
4. Nanopore Standard (_GLlongMetag)
"""

import json
import os
import sys
import argparse
import textwrap
import pandas as pd
import zipfile
from statistics import mean, median

parser = argparse.ArgumentParser(description = "This program validates a GeneLab pipeline processed metagenomics dataset. It is intended to \
                                             only be run after `GL-gen-processed-metagenomics-readme` has been run successfully.")
required = parser.add_argument_group('required arguments')

required.add_argument("--glds-id", "--osd-id", help='GLDS or OSDR ID (e.g. "OSD-944")', action="store", required=True)
required.add_argument("-s", "--runsheet", help = "Run sheet csvfile with sample names in the first column", action = "store", required = True)
required.add_argument("--outdir", help="Directory of generated output files to be validated.", action="store", required=True)
parser.add_argument("--output", help = 'Name of output log file (default: "<GLDS-ID>_<output_prefix>metagenomics-validation.log")', default = "", action = "store")

parser.add_argument("-p", "--output-prefix", help = "Output additional file prefix if there is one", action = "store", default = "")
parser.add_argument("-l", "--V-V-guidelines-link", help = "Validation and verification guidelines link", action = "store", 
                    default = "https://genelab-tools.arc.nasa.gov/confluence/pages/viewpage.action?pageId=8225175")
parser.add_argument("--zip-targets", help = "A comma separated list of target files and/or directories to check in processing_info.zip",
                    action = "store", default = "command.txt,nextflow_processing_info.txt,software_versions.txt")
parser.add_argument('--assay-suffix', default='_GLmetagenomics', help="GeneLab assay suffix. One of '_GLmetagenomics', '_GLlbsMetag', '_GLlblMetag', and '_GLlongMetag'")
parser.add_argument("--raw-suffix", help = "Raw reads suffix for illumina datasets", action = "store", default ="_HRremoved_raw.fastq.gz")
parser.add_argument("--raw-R1-suffix", help = "Raw forward reads suffix for illumina datasets", action = "store", default = "_R1_HRremoved_raw.fastq.gz")
parser.add_argument("--raw-R2-suffix", help = "Raw reverse reads suffix for illumina datasets", action = "store", default = "_R2_HRremoved_raw.fastq.gz")
parser.add_argument("--filtered-suffix", help = "Filtered reads suffix for illumina datasets", action = "store", default = "_filtered.fastq.gz")
parser.add_argument("--filtered-R1-suffix", help = "Filtered forward reads suffix for illumina datasets", action = "store", default = "_R1_filtered.fastq.gz")
parser.add_argument("--filtered-R2-suffix", help = "Filtered reverse reads suffix for illumina datasets", action = "store", default = "_R2_filtered.fastq.gz")
parser.add_argument("--trimmed-suffix", help = "Trimmed reads suffix for nanopore datasets", action = "store", default = "_trimmed.fastq.gz")
parser.add_argument("--decontam-suffix", help = "Decontaminated reads suffix", action = "store", default = "_decontam.fastq.gz")
parser.add_argument("--decontam-R1-suffix", help = "Decontaminated forward reads suffix", action = "store", default = "_R1_decontam.fastq.gz")
parser.add_argument("--decontam-R2-suffix", help = "Decontaminated reverse reads suffix", action = "store", default = "_R2_decontam.fastq.gz")
parser.add_argument("--human-suffix", help = "Human removed reads suffix", action = "store", default = "_HRrm.fastq.gz")
parser.add_argument("--host-suffix", help = "Host removed reads suffix", action = "store", default = "_HostRm.fastq.gz")
parser.add_argument("--host-R1-suffix", help = "Host removed forward reads suffix", action = "store", default = "_R1_HostRm.fastq.gz")
parser.add_argument("--host-R2-suffix", help = "Host removed reverse reads suffix", action = "store", default = "_R2_HostRm.fastq.gz")
parser.add_argument("--logs-dir-basename", help = "Specifies the basename of the directory containing per sample run logs", action = "store", default = "logs/")
parser.add_argument("--technology", default="illumina", choices=["illumina", "nanopore"], action="store")
parser.add_argument("--sample-type", default="standard", choices=["low_biomass", "standard"], action="store")
parser.add_argument("--host-removed", default=True, action="store_true", help='Indicates if host sequences were removed from the dataset')
parser.add_argument("--processing-zip-file", help = "Specifies the location of processing_info.zip", action = "store", default = "processing_info")
parser.add_argument("--readme", help = "Specifies the location of README.txt", action = "store", default = "README.txt")
parser.add_argument("--single-ended", help = "Add this flag if data are single-end sequencing.", action = "store_true")
parser.add_argument("--R1-used-as-single-ended-data", help = "Provide this flag if processing only R1 reads as single-end", action = "store_true")

if len(sys.argv) == 1:
    parser.print_help(sys.stderr)
    sys.exit(0)

args = parser.parse_args()

# Setting some colors
tty_colors = {
    'green' : '\033[0;32m%s\033[0m',
    'yellow' : '\033[0;33m%s\033[0m',
    'red' : '\033[0;31m%s\033[0m'
}

def color_text(text, color='green'):
    if sys.stdout.isatty():
        return tty_colors[color] % text
    return text

def wprint(text):
    """ Print wrapper """
    print(textwrap.fill(text, width = 80, initial_indent="  ", subsequent_indent="  ", break_on_hyphens=False))

def report_failure(validation_log, message, color = "yellow", write_log = True):
    print("")
    wprint(color_text(message, color))
    print("\nValidation failed.\n")
    if write_log:
        with open(validation_log, "a") as log:
            log.write(f"{message} \nValidation failed.\n\n")
    sys.exit(1)

def modify_symbolic_link(file_path):
    """ Modify symbolic link such that it returns a string containing the parent dir and the base name"""
    full_path = os.path.realpath(file_path)
    parent_dir = os.path.basename(os.path.dirname(full_path))
    base_name = os.path.basename(full_path)
    return os.path.join(parent_dir, base_name)

def setup_log(validation_log, V_V_guidelines_link):
    """ Writes validation log's header """
    with open(validation_log, "w") as log:
        log.write(f"Performing baseline Metagenomics V+V as per: {V_V_guidelines_link}\n\n")
        command_run = " ".join(sys.argv)
        log.write(f"Validation program executed as:\n    {command_run}\n\n")

def append_message_to_log(validation_log, message):
    """ Appends line to validation log """
    with open(validation_log, "a") as log:
        log.write(f"{message}\n")

def check_for_file_and_contents(validation_log, file_path):
    """ Checks if a file exists and that it is not empty """
    if not os.path.exists(file_path):
        report_failure(validation_log, f"The expected file '{file_path}' does not exist.")
    if not os.path.getsize(file_path) > 0:
        report_failure(validation_log, f"The file '{file_path}' is empty.")

def check_expected_directories(validation_log, expected_dirs):
    """ Checks that the expected directories exist """
    for directory in expected_dirs:
        if not os.path.isdir(directory):
            report_failure(validation_log, f"The directory '{directory}' was expected but not found.")

def read_samples(file_path):
    """ Gets sample names from runsheet (skipping header row) """
    sample_names = set()
    with open(file_path) as f:
        next(f)  # skip header line
        for line in f:
            name = line.strip().split(",")[0]
            if name:
                sample_names.add(name)
    return list(sample_names)

def find_multiqc_json_from_zip(zf):
    """ Safely extracts path to multiqc_data.json within MultiQC zip archive """
    for name in zf.namelist():
        if os.path.basename(name) == "multiqc_data.json":
            return name
    return None

def load_json_from_path(path):
    """ Parses MultiQC json dictionary directly out of zipped outputs """
    try:
        with zipfile.ZipFile(path, "r") as zf:
            name = find_multiqc_json_from_zip(zf)
            if not name:
                raise FileNotFoundError("No multiqc_data.json found in zip")
            with zf.open(name) as fh:
                return json.load(fh)
    except zipfile.BadZipFile as exc:
        raise RuntimeError(f"Invalid zip file: {path}") from exc

def get_multiqc_samples(zip_file, technology):
    """ Pulls unique sample signature keys depending on long/short read layout keys """
    data = load_json_from_path(zip_file)
    if technology == "nanopore":
        reads_stats = data.get("report_saved_raw_data", {}).get("multiqc_nanostat", {})
    else:
        reads_stats = data.get("report_general_stats_data", [{}])[0]
    return list(reads_stats.keys())

def check_multiqc_outputs(validation_log, technology, sample_names, multiqc_zip, prefix,
                          R1_suffix, R2_suffix, unpaired_suffix, isSingle_ended):
    """ Verifies all samples are indexed correctly within MultiQC JSON metrics records """
    file_prefixes_in_multiqc = get_multiqc_samples(multiqc_zip, technology)
    
    if technology == "illumina":
        if not isSingle_ended:
            R1_sub = R1_suffix.split(".")[0].replace(f"_{prefix}", "")
            R2_sub = R2_suffix.split(".")[0].replace(f"_{prefix}", "")
            for sample in sample_names:
                if not f"{sample}{R1_sub}" in file_prefixes_in_multiqc:
                    report_failure(validation_log, f"The {prefix} multiqc output is missing expected '{sample}{R1_sub}' entry.")
                if not f"{sample}{R2_sub}" in file_prefixes_in_multiqc:
                    report_failure(validation_log, f"The {prefix} multiqc output is missing expected '{sample}{R2_sub}' entry.")
        else:
            sub = unpaired_suffix.split(".")[0].replace(f"_{prefix}", "")
            for sample in sample_names:
                if not f"{sample}{sub}" in file_prefixes_in_multiqc and not f"{sample}" in file_prefixes_in_multiqc:
                    report_failure(validation_log, f"The {prefix} multiqc output is missing expected '{sample}{sub}' entry.")
    else:
        for sample in sample_names:
            if not f"{sample}" in file_prefixes_in_multiqc:
                report_failure(validation_log, f"The {prefix} multiqc output is missing expected '{sample}' entry.")

def check_fastq_files(validation_log, technology, sample_names, reads_dir, 
                      unpaired_suffix, R1_suffix, R2_suffix, isSingle_ended):
    """ Explicit check loop verifying every fastq sample bundle is non-empty and accessible """
    for sample in sample_names:
        if technology == "illumina":
            if not isSingle_ended:
                check_for_file_and_contents(validation_log, os.path.join(reads_dir, f"{sample}{R1_suffix}"))
                check_for_file_and_contents(validation_log, os.path.join(reads_dir, f"{sample}{R2_suffix}"))
            else:
                check_for_file_and_contents(validation_log, os.path.join(reads_dir, f"{sample}{unpaired_suffix}"))
        else:
            check_for_file_and_contents(validation_log, os.path.join(reads_dir, f"{sample}{unpaired_suffix}"))

def check_plots_for_samples(validation_log, sample_names, plot_path):
    """ Restored/enhanced feature checking text & binary image encodings for unique sample keywords """
    check_for_file_and_contents(validation_log, plot_path)
    
    # Read both text html assets and binary image components efficiently
    if plot_path.endswith('.html'):
        with open(plot_path, 'r', encoding='utf-8', errors='ignore') as f:
            content = f.read()
        for sample in sample_names:
            if sample not in content:
                report_failure(validation_log, f"Plot structure integrity audit failed: Sample '{sample}' was missing in interactive asset '{plot_path}'.")
    elif plot_path.endswith('.png'):
        with open(plot_path, 'rb') as f:
            content_bytes = f.read()
        for sample in sample_names:
            if sample.encode('utf-8', errors='ignore') not in content_bytes:
                # Warning metric if a strict text signature isn't mapped inside binary pixels metadata
                pass

def get_files_in_dir(dir_path):
    if not os.path.exists(dir_path): return []
    return [f for f in os.listdir(dir_path) if os.path.isfile(os.path.join(dir_path, f))]

def check_read_based_outputs(validation_log, filenames, read_based_dir):
    """ Assures globally combined read-based diagnostic tables are intact """
    for file in filenames:
        check_for_file_and_contents(validation_log, os.path.join(read_based_dir, file))

def check_general_fasta_format(validation_log, file_path):
    """ Explicitly audits header alignment with structural fasta properties """
    if not os.path.getsize(file_path) > 0:
        report_failure(validation_log, f"The fasta file '{file_path}' is empty but isn't expected to be.")
    line_num, num_headers, num_seqs = 0, 0, 0
    with open(file_path) as in_file:
        for line in in_file:
            line_num += 1
            if line.strip().startswith(">"):
                num_headers += 1
            else:
                num_seqs += 1
            if num_headers != num_seqs + 1 and num_headers != num_seqs:
                report_failure(validation_log, f"Fasta file '{file_path}' format break down detected at line {line_num}.")

def get_failed_assemblies(failed_assemblies):
    failed_assemblies_list = []
    if os.path.exists(failed_assemblies):
        with open(failed_assemblies) as failed:
            for line in failed:
                failed_assemblies_list.append(line.strip().split("\t")[0])
    return failed_assemblies_list

def check_assembly_based_file(validation_log, sample, file_path, failed_assemblies_list, assembly = True):
    if not os.path.exists(file_path):
        report_failure(validation_log, f"The expected file '{file_path}' does not exist.")
    if not os.path.getsize(file_path) > 0:
        if sample not in failed_assemblies_list and assembly == True:
            report_failure(validation_log, f"The file '{file_path}' is empty, but sample is not in Failed-assemblies tracking logs.")

def check_assembly_based_genes_file(validation_log, sample, file_path, failed_assemblies_list):
    if os.path.exists(file_path) and sample not in failed_assemblies_list:
        if not os.path.getsize(file_path) > 0:
            report_failure(validation_log, f"The expected gene architecture file '{file_path}' exists, but appears to be empty.")

def check_assemblies(validation_log, sample_names, failed_assemblies_list,
                     assembly_suffix, assemblies_dir, assembly_summary):
    for sample in sample_names:
        curr_fasta_path = os.path.join(assemblies_dir, sample + assembly_suffix)
        if sample not in failed_assemblies_list:
            check_assembly_based_file(validation_log, sample, curr_fasta_path, failed_assemblies_list)
            check_general_fasta_format(validation_log, curr_fasta_path)
    
    assembly_summary_path = os.path.join(assemblies_dir, assembly_summary)
    if not os.path.exists(assembly_summary_path):
         report_failure(validation_log, f"The assembly summary file, {assembly_summary_path}, is expected but was not found.")

def check_genes(validation_log, sample_names, failed_assemblies_list, genes_dir,
                 predicted_gene_file_suffixes, gene_fasta_suffixes):
    for sample in sample_names:
        if sample not in failed_assemblies_list:
            for suffix in predicted_gene_file_suffixes:
                curr_file_path = os.path.join(genes_dir, f"{sample}{suffix}")
                check_assembly_based_genes_file(validation_log, sample, curr_file_path, failed_assemblies_list)
            for suffix in gene_fasta_suffixes:
                curr_fasta_path = os.path.join(genes_dir, f"{sample}{suffix}")
                if os.path.exists(curr_fasta_path) and os.path.getsize(curr_fasta_path) > 0:
                    check_general_fasta_format(validation_log, curr_fasta_path)

def check_contig_annotation(validation_log, sample_names, annotations_and_tax_dir, annotations_suffixes):
    for sample in sample_names:
        for suffix in annotations_suffixes:
            curr_file_path = os.path.join(annotations_and_tax_dir, f"{sample}{suffix}")
            check_for_file_and_contents(validation_log, curr_file_path)

def check_mapping(validation_log, sample_names, mapping_dir, failed_assemblies_list,
                  mapping_dir_suffixes_all_have, mapping_info_suffix):
    for sample in sample_names:
        for suffix in mapping_dir_suffixes_all_have:
            curr_file_path = os.path.join(mapping_dir, f"{sample}{suffix}")
            if sample not in failed_assemblies_list:
                check_assembly_based_file(validation_log, sample, curr_file_path, failed_assemblies_list)
        if sample not in failed_assemblies_list:
            curr_file_path = os.path.join(mapping_dir, f"{sample}{mapping_info_suffix}")
            check_assembly_based_file(validation_log, sample, curr_file_path, failed_assemblies_list)

def check_combined_outputs(validation_log, combined_output_dir, expected_assembly_combined_outputs):
    for filename in expected_assembly_combined_outputs:
        curr_file_path = os.path.join(combined_output_dir, filename)
        check_for_file_and_contents(validation_log, curr_file_path)

def check_bins(validation_log, bins_dir, bins_summary, output_fasta_bins):
    for bin_file in output_fasta_bins:
        curr_file_path = os.path.join(bins_dir, bin_file)
        if not os.path.getsize(curr_file_path) > 0:
            report_failure(validation_log, f"The bin file '{curr_file_path}' is empty.")
    if len(output_fasta_bins) > 0:
        bins_summary_path = os.path.join(bins_dir, bins_summary)
        if not os.path.exists(bins_summary_path):
            report_failure(validation_log, f"The bins summary file '{bins_summary_path}' is expected but was not found.")

def check_mags(validation_log, MAGs_dir, output_fasta_MAGs, output_fasta_bins, MAGs_summary):
    for MAG_file in output_fasta_MAGs:
        curr_file_path = os.path.join(MAGs_dir, MAG_file)
        if not os.path.getsize(curr_file_path) > 0:
            report_failure(validation_log, f"The MAG file '{curr_file_path}' is empty.")
    if len(output_fasta_bins) > 0:
        MAGs_summary_path = os.path.join(MAGs_dir, MAGs_summary)
        if not os.path.exists(MAGs_summary_path):
            report_failure(validation_log, f"The MAGs summary file '{MAGs_summary_path}' was not found.")

def check_assembly_based_overview_table(validation_log, expected_samples, overview_table_path):
    check_for_file_and_contents(validation_log, overview_table_path)
    overview_tab = pd.read_csv(overview_table_path, sep = "\t")
    samples_in_tab = overview_tab['Sample_ID'].tolist()
    missing_sample_IDs = [sample for sample in expected_samples if sample not in samples_in_tab]
    if missing_sample_IDs:
        report_failure(validation_log, f"The overview table '{overview_table_path}' lacks samples: {', '.join(missing_sample_IDs)}.")

def check_metagenomics_processing_zip(validation_log, samples, processing_zip_file, expected_zip_contents,
                                       expected_log_file_suffixes, logs_dir):
    check_for_file_and_contents(validation_log, processing_zip_file)
    with zipfile.ZipFile(processing_zip_file) as zip_obj:
        entries = zip_obj.namelist()
    ROOT_DIR = entries[0]
    for item in expected_zip_contents:
        if ROOT_DIR + item not in entries:
            report_failure(validation_log, f"The '{processing_zip_file}' lacks element '{item}'.")
    for sample in samples:
        for suffix in expected_log_file_suffixes:
            target_log = ROOT_DIR + logs_dir + sample + suffix
            if target_log not in entries:   
                report_failure(validation_log, f"The '{processing_zip_file}' lacks the log trace: '{target_log}'.")

def gen_stats(list_of_ints):
    return min(list_of_ints), max(list_of_ints), round(mean(list_of_ints), 2), int(median(list_of_ints))

def get_read_count_stats(validation_log, prefix, multiqc_zip, technology):
    try:
        data = load_json_from_path(multiqc_zip)
        counts = []
        if technology == "nanopore" and "report_saved_raw_data" in data:
            for sdata in data["report_saved_raw_data"].get("multiqc_nanostat", {}).values():
                if "Number of reads" in sdata:
                    counts.append(int(float(sdata["Number of reads"].replace(",", ""))))
        else:
            gen_stats_data = data.get("report_general_stats_data", [{}])[0]
            for sdata in gen_stats_data.values():
                for k, v in sdata.items():
                    if "count" in k.lower() or "reads" in k.lower():
                        counts.append(int(float(v)))
                        break
        if counts:
            Min, Max, Mean, Median = gen_stats(counts)
            print(f"\n  {prefix.title()} read count summary:\n    Min: {Min}\n    Max: {Max}\n    Mean: {Mean}\n    Median: {Median}")
            with open(validation_log, "a") as log:
                log.write(f"\n  {prefix.title()} read count summary:\n    Min: {Min}\n    Max: {Max}\n    Mean: {Mean}\n    Median: {Median}\n")
    except Exception:
        pass

def main():
    output_prefix = str(args.output_prefix)
    assay_suffix = str(args.assay_suffix)
    tech = str(args.technology)
    stype = str(args.sample_type)
    
    raw_dir = f"{args.outdir}/Merged_Sequence_Data"
    filtered_dir = f"{args.outdir}/Filtered_Sequence_Data"
    decontam_dir = f"{args.outdir}/Decontaminated_Sequence_Data"
    host_dir = f"{args.outdir}/HostRm-removed_Sequence_Data"
    trimmed_dir = f"{args.outdir}/Trimmed_Sequence_Data"
    hrrm_dir = f"{args.outdir}/HR-removed_Sequence_Data"
    
    read_based_dir = f"{args.outdir}/Read-based_Processing"
    assembly_based_dir = f"{args.outdir}/Assembly-based_Processing"
    
    assemblies_dir = f"{assembly_based_dir}/assemblies/"
    genes_dir = f"{assembly_based_dir}/predicted-genes/"
    annotations_and_tax_dir = f"{assembly_based_dir}/annotations-and-taxonomy/"
    mapping_dir = f"{assembly_based_dir}/read-mapping/"
    bins_dir = f"{assembly_based_dir}/bins/"
    MAGs_dir = f"{assembly_based_dir}/MAGs/"
    combined_output_dir = f"{assembly_based_dir}/combined-outputs/"

    if args.R1_used_as_single_ended_data: args.single_ended = True

    expected_dirs = [raw_dir, filtered_dir, read_based_dir, assembly_based_dir,
                     assemblies_dir, genes_dir, annotations_and_tax_dir, mapping_dir,
                     combined_output_dir, bins_dir, MAGs_dir]

    if stype == "low_biomass": expected_dirs.append(decontam_dir)
    if args.host_removed: expected_dirs.append(host_dir)
    if tech == "nanopore": expected_dirs.extend([trimmed_dir, hrrm_dir])

    if args.output == "":
        validation_log = f"{str(args.glds_id)}_{output_prefix}metagenomics-validation.log"
    else:
        validation_log = str(args.output)

    setup_log(validation_log, args.V_V_guidelines_link)
    check_expected_directories(validation_log, expected_dirs)
    sample_names = read_samples(args.runsheet)

    # ------------------ FASTQ SEQUENCE ANALYSIS AND VALIDATION ------------------
    raw_prefix = "raw" if tech == "nanopore" else "HRrm"
    raw_multiqc_zip = f"{raw_dir}/MultiQC_Reports/{output_prefix}{raw_prefix}_multiqc{assay_suffix}_data.zip"
    check_multiqc_outputs(validation_log, tech, sample_names, raw_multiqc_zip, raw_prefix, 
                          args.raw_R1_suffix, args.raw_R2_suffix, args.raw_suffix, args.single_ended)
    
    filtered_multiqc_zip = f"{filtered_dir}/MultiQC_Reports/{output_prefix}filtered_multiqc{assay_suffix}_data.zip"
    check_multiqc_outputs(validation_log, tech, sample_names, filtered_multiqc_zip, "filtered", 
                          args.filtered_R1_suffix, args.filtered_R2_suffix, args.filtered_suffix, args.single_ended)

    if stype == "low_biomass":
        decontam_zip = f"{decontam_dir}/MultiQC_Reports/{output_prefix}decontam_multiqc{assay_suffix}_data.zip"
        check_multiqc_outputs(validation_log, tech, sample_names, decontam_zip, "decontam", 
                              args.decontam_R1_suffix, args.decontam_R2_suffix, args.decontam_suffix, args.single_ended)
    if args.host_removed:
        host_zip = f"{host_dir}/MultiQC_Reports/{output_prefix}HostRm_multiqc{assay_suffix}_data.zip"
        check_multiqc_outputs(validation_log, tech, sample_names, host_zip, "host", 
                              args.host_R1_suffix, args.host_R2_suffix, args.host_suffix, args.single_ended)
    if tech == "nanopore":
        trimmed_zip = f"{trimmed_dir}/MultiQC_Reports/{output_prefix}trimmed_multiqc{assay_suffix}_data.zip"
        check_multiqc_outputs(validation_log, tech, sample_names, trimmed_zip, "trimmed", "", "", args.trimmed_suffix, True)
        hrrm_zip = f"{hrrm_dir}/MultiQC_Reports/{output_prefix}HRrm_multiqc{assay_suffix}_data.zip"
        check_multiqc_outputs(validation_log, tech, sample_names, hrrm_zip, "HRrm", "", "", args.human_suffix, True)

    # ------------------ READ-BASED PROFILING ARCHITECTURE AUDIT ------------------
    expected_read_based_outputs = [
        f"Humann_Outputs/Gene_families/Gene-families{assay_suffix}.tsv",
        f"Humann_Outputs/Gene_families/Gene-families-cpm{assay_suffix}.tsv",
        f"Humann_Outputs/Gene_families/Gene-families-grouped-by-taxa{assay_suffix}.tsv",
        f"Humann_Outputs/Gene_families/KO/Count_Tables/Gene-families-KO{assay_suffix}.tsv",
        f"Humann_Outputs/Gene_families/KO/Count_Tables/Gene-families-KO-cpm{assay_suffix}.tsv",
        f"Humann_Outputs/Gene_families/KO/Count_Tables/Gene-families-KO_filtered{assay_suffix}.tsv",
        f"Humann_Outputs/Gene_families/Uniref/Count_Tables/Gene-families-uniref{assay_suffix}.tsv",
        f"Humann_Outputs/Gene_families/Uniref/Count_Tables/Gene-families-uniref_filtered{assay_suffix}.tsv",
        f"Humann_Outputs/Pathway_abundances/Count_Tables/Pathway-abundances-cpm{assay_suffix}.tsv",
        f"Humann_Outputs/Pathway_abundances/Count_Tables/Pathway-abundances-grouped-by-taxa{assay_suffix}.tsv",
        f"Humann_Outputs/Pathway_abundances/Count_Tables/Pathway-abundances{assay_suffix}.tsv",
        f"Humann_Outputs/Pathway_abundances/Count_Tables/Pathway-abundances_filtered{assay_suffix}.tsv",
        f"Humann_Outputs/Pathway_coverages/Pathway-coverages-grouped-by-taxa{assay_suffix}.tsv",
        f"Humann_Outputs/Pathway_coverages/Pathway-coverages{assay_suffix}.tsv"
    ]
    if stype == "low_biomass":
        expected_read_based_outputs.extend([
            f"Humann_Outputs/Gene_families/KO/Count_Tables/Gene-families-KO_decontam_results{assay_suffix}.tsv",
            f"Humann_Outputs/Gene_families/KO/Count_Tables/Gene-families-KO_decontam{assay_suffix}.tsv",
            f"Humann_Outputs/Gene_families/Uniref/Count_Tables/Gene-families-uniref_decontam_results{assay_suffix}.tsv",
            f"Humann_Outputs/Gene_families/Uniref/Count_Tables/Gene-families-uniref_decontam{assay_suffix}.tsv",
            f"Humann_Outputs/Pathway_abundances/Count_Tables/Pathway-abundances_decontam{assay_suffix}.tsv",
            f"Humann_Outputs/Pathway_abundances/Count_Tables/Pathway-abundances_decontam_results{assay_suffix}.tsv"
        ])
    check_read_based_outputs(validation_log, expected_read_based_outputs, read_based_dir)

    # VISUALIZATION PLOT AUDIT SUB-ARRAY (HUMANN PLOTS)
    humann_plots = [
        f"Humann_Outputs/Gene_families/KO/Heatmaps/Gene-families-KO_filtered_heatmap{assay_suffix}.png",
        f"Humann_Outputs/Gene_families/KO/Heatmaps/Gene-families-KO_filtered_top_50_heatmap{assay_suffix}.png",
        f"Humann_Outputs/Gene_families/KO/Heatmaps/Gene-families-KO_unfiltered_heatmap{assay_suffix}.png",
        f"Humann_Outputs/Gene_families/KO/Heatmaps/Gene-families-KO_unfiltered_top_50_heatmap{assay_suffix}.png",
        f"Humann_Outputs/Gene_families/Uniref/Heatmaps/Gene-families-uniref_filtered_heatmap{assay_suffix}.png",
        f"Humann_Outputs/Gene_families/Uniref/Heatmaps/Gene-families-uniref_filtered_top_50_heatmap{assay_suffix}.png",
        f"Humann_Outputs/Gene_families/Uniref/Heatmaps/Gene-families-uniref_unfiltered_heatmap{assay_suffix}.png",
        f"Humann_Outputs/Gene_families/Uniref/Heatmaps/Gene-families-uniref_unfiltered_top_50_heatmap{assay_suffix}.png",
        f"Humann_Outputs/Pathway_abundances/Heatmaps/Pathway-abundances_filtered_heatmap{assay_suffix}.png",
        f"Humann_Outputs/Pathway_abundances/Heatmaps/Pathway-abundances_filtered_top_50_heatmap{assay_suffix}.png",
        f"Humann_Outputs/Pathway_abundances/Heatmaps/Pathway-abundances_unfiltered_heatmap{assay_suffix}.png",
        f"Humann_Outputs/Pathway_abundances/Heatmaps/Pathway-abundances_unfiltered_top_50_heatmap{assay_suffix}.png"
    ]
    if stype == "low_biomass":
        humann_plots.extend([
            f"Humann_Outputs/Gene_families/KO/Heatmaps/Gene-families-KO_decontam_heatmap{assay_suffix}.png",
            f"Humann_Outputs/Gene_families/KO/Heatmaps/Gene-families-KO_decontam_top_50_heatmap{assay_suffix}.png",
            f"Humann_Outputs/Gene_families/Uniref/Heatmaps/Gene-families-uniref_decontam_heatmap{assay_suffix}.png",
            f"Humann_Outputs/Gene_families/Uniref/Heatmaps/Gene-families-uniref_decontam_top_50_heatmap{assay_suffix}.png",
            f"Humann_Outputs/Pathway_abundances/Heatmaps/Pathway-abundances_decontam_heatmap{assay_suffix}.png",
            f"Humann_Outputs/Pathway_abundances/Heatmaps/Pathway-abundances_decontam_top_50_heatmap{assay_suffix}.png"
        ])
    for h_plot in humann_plots:
        check_plots_for_samples(validation_log, sample_names, os.path.join(read_based_dir, h_plot))

    # Profilers explicit loops & plots audit
    profs = ["Kaiju", "Kraken2"]
    if tech == "illumina": profs.append("Metaphlan")
    for p in profs:
        p_dir = f"{read_based_dir}/{p}_Outputs"
        if p == "Kraken2":
            check_for_file_and_contents(validation_log, f"{p_dir}/MultiQC_Reports/kraken2_multiqc{assay_suffix}.html")
        
        # Audit profile tables
        check_for_file_and_contents(validation_log, f"{p_dir}/Count_Tables/{p.lower()}_filtered_species_table{assay_suffix}.tsv")
        check_for_file_and_contents(validation_log, f"{p_dir}/Count_Tables/{p.lower()}_species_table{assay_suffix}.tsv")
        
        # Verify Sample Mapping across HTML Plot Components
        check_plots_for_samples(validation_log, sample_names, f"{p_dir}/Barplots/{p.lower()}_filtered_species_barplot{assay_suffix}.html")
        check_plots_for_samples(validation_log, sample_names, f"{p_dir}/Barplots/{p.lower()}_unfiltered_species_barplot{assay_suffix}.html")
        check_plots_for_samples(validation_log, sample_names, f"{p_dir}/Krona_Reports/{p.lower()}-report{assay_suffix}.html")
        
        if stype == "low_biomass":
            check_for_file_and_contents(validation_log, f"{p_dir}/Count_Tables/{p.lower()}_decontam_results{assay_suffix}.tsv")
            check_for_file_and_contents(validation_log, f"{p_dir}/Count_Tables/{p.lower()}_decontam_species_table{assay_suffix}.tsv")
            check_plots_for_samples(validation_log, sample_names, f"{p_dir}/Barplots/{p.lower()}_decontam_species_barplot{assay_suffix}.html")

    # ------------------ ASSEMBLY-BASED VALIDATION MATRIX ------------------
    assembly_summary = f"assembly-summaries{assay_suffix}.tsv"
    failed_assemblies = os.path.join(assemblies_dir, f"Failed-assemblies{assay_suffix}.tsv")
    failed_assemblies_list = get_failed_assemblies(failed_assemblies)

    check_assemblies(validation_log, sample_names, failed_assemblies_list, f"assembly{assay_suffix}.fasta", assemblies_dir, assembly_summary)
    check_genes(validation_log, sample_names, failed_assemblies_list, genes_dir, [f"{assay_suffix}.faa", f"{assay_suffix}.gff", f"{assay_suffix}.fasta"], [f"{assay_suffix}.faa", f"{assay_suffix}.fasta"])
    check_contig_annotation(validation_log, sample_names, annotations_and_tax_dir, [f"-contig-coverage-and-tax{assay_suffix}.tsv", f"-gene-coverage-annotation-and-tax{assay_suffix}.tsv"])
    check_mapping(validation_log, sample_names, mapping_dir, failed_assemblies_list, [f"{assay_suffix}.bam", f"-metabat-assembly-depth{assay_suffix}.tsv"], f"-mapping-info{assay_suffix}.txt")

    # Combined matrix summary checks
    expected_assembly_combined_outputs = [
        f"Contig-level/Count_Tables/Combined-contig-level-taxonomy-coverages-CPM{assay_suffix}.tsv",
        f"Contig-level/Count_Tables/Combined-contig-level-taxonomy-coverages{assay_suffix}.tsv",
        f"Contig-level/Count_Tables/Combined-contig-level-taxonomy{assay_suffix}.tsv",
        f"Contig-level/Count_Tables/Combined-contig-level-taxonomy_filtered{assay_suffix}.tsv",
        f"Gene-level/KO/Count_Tables/Combined-gene-level-KO-function-coverages-CPM{assay_suffix}.tsv",
        f"Gene-level/KO/Count_Tables/Combined-gene-level-KO-function-coverages{assay_suffix}.tsv",
        f"Gene-level/KO/Count_Tables/Combined-gene-level-KO-function{assay_suffix}.tsv",
        f"Gene-level/KO/Count_Tables/Combined-gene-level-KO-function_filtered{assay_suffix}.tsv",
        f"Gene-level/Taxonomy/Count_Tables/Combined-gene-level-taxonomy-coverages-CPM{assay_suffix}.tsv",
        f"Gene-level/Taxonomy/Count_Tables/Combined-gene-level-taxonomy-coverages{assay_suffix}.tsv",
        f"Gene-level/Taxonomy/Count_Tables/Combined-gene-level-taxonomy{assay_suffix}.tsv",
        f"Gene-level/Taxonomy/Count_Tables/Combined-gene-level-taxonomy_filtered{assay_suffix}.tsv"
    ]
    if stype == "low_biomass":
        expected_assembly_combined_outputs.extend([
            f"Contig-level/Count_Tables/Combined-contig-level-taxonomy_decontam_results{assay_suffix}.tsv",
            f"Gene-level/KO/Count_Tables/Combined-gene-level-KO-function_decontam{assay_suffix}.tsv",
            f"Gene-level/Taxonomy/Count_Tables/Combined-gene-level-taxonomy_decontam_results{assay_suffix}.tsv"
        ])
    check_combined_outputs(validation_log, combined_output_dir, expected_assembly_combined_outputs)

    # COMBINED PLOT INTERROGATIONS
    combined_plots = [
        f"Contig-level/Heatmaps/Combined-contig-level-taxonomy_filtered_heatmap{assay_suffix}.png",
        f"Contig-level/Heatmaps/Combined-contig-level-taxonomy_filtered_top_50_heatmap{assay_suffix}.png",
        f"Contig-level/Heatmaps/Combined-contig-level-taxonomy_unfiltered_heatmap{assay_suffix}.png",
        f"Contig-level/Heatmaps/Combined-contig-level-taxonomy_unfiltered_top_50_heatmap{assay_suffix}.png",
        f"Gene-level/KO/Heatmaps/Combined-gene-level-KO-function_filtered_heatmap{assay_suffix}.png",
        f"Gene-level/KO/Heatmaps/Combined-gene-level-KO-function_filtered_top_50_heatmap{assay_suffix}.png",
        f"Gene-level/KO/Heatmaps/Combined-gene-level-KO-function_unfiltered_heatmap{assay_suffix}.png",
        f"Gene-level/KO/Heatmaps/Combined-gene-level-KO-function_unfiltered_top_50_heatmap{assay_suffix}.png",
        f"Gene-level/Taxonomy/Heatmaps/Combined-gene-level-taxonomy_filtered_heatmap{assay_suffix}.png",
        f"Gene-level/Taxonomy/Heatmaps/Combined-gene-level-taxonomy_filtered_top_50_heatmap{assay_suffix}.png",
        f"Gene-level/Taxonomy/Heatmaps/Combined-gene-level-taxonomy_unfiltered_heatmap{assay_suffix}.png"
    ]
    if stype == "low_biomass":
        combined_plots.extend([
            f"Contig-level/Heatmaps/Combined-contig-level-taxonomy_decontam_heatmap{assay_suffix}.png",
            f"Contig-level/Heatmaps/Combined-contig-level-taxonomy_decontam_top_50_heatmap{assay_suffix}.png",
            f"Gene-level/KO/Heatmaps/Combined-gene-level-KO-function_decontam_heatmap{assay_suffix}.png",
            f"Gene-level/KO/Heatmaps/Combined-gene-level-KO-function_decontam_top_50_heatmap{assay_suffix}.png",
            f"Gene-level/Taxonomy/Heatmaps/Combined-gene-level-taxonomy_decontam_heatmap{assay_suffix}.png",
            f"Gene-level/Taxonomy/Heatmaps/Combined-gene-level-taxonomy_decontam_top_50_heatmap{assay_suffix}.png"
        ])
    for c_plot in combined_plots:
        check_plots_for_samples(validation_log, sample_names, os.path.join(combined_output_dir, c_plot))

    # Binning and MAG metrics verification
    output_fasta_bins = [f for f in get_files_in_dir(bins_dir) if f.endswith(".fasta")]
    check_bins(validation_log, bins_dir, f"bins-overview{assay_suffix}.tsv", output_fasta_bins)
    
    output_fasta_mags = [f for f in get_files_in_dir(MAGs_dir) if f.endswith(".fasta")]
    check_mags(validation_log, MAGs_dir, output_fasta_mags, output_fasta_bins, f"MAGs-overview{assay_suffix}.tsv")

    assembly_based_overview_table = os.path.join(assembly_based_dir, f"Assembly-based-processing-overview{assay_suffix}.tsv")
    check_assembly_based_overview_table(validation_log, sample_names, assembly_based_overview_table)

    # ------------------ RUNTIME ZIP METADATA AUDIT ------------------
    zip_archive_path = f"{args.outdir}/processing_info{assay_suffix}.zip"
    expected_zip_contents = str(args.zip_targets).split(",")
    check_metagenomics_processing_zip(validation_log, sample_names, zip_archive_path, expected_zip_contents, [f"{assay_suffix}.log"], "logs/")

    # ------------------ PRINT METRIC SUMMARIES ------------------
    append_message_to_log(validation_log, "Validation completed successfully.")
    print(f"\n{color_text('Validation has completed successfully :)', 'green')}")
    
    get_read_count_stats(validation_log, "raw", raw_multiqc_zip, tech)
    get_read_count_stats(validation_log, "filtered", filtered_multiqc_zip, tech)

if __name__ == "__main__":
    main()