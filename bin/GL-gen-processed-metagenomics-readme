#!/usr/bin/env python

"""
This is a program for generating a README.txt file for GeneLab processed metagenomics datasets.
It has been updated to follow the tree-style formatting and the specific directory structure 
provided in the dir_struct.txt file.
"""

import sys
import argparse
import datetime

# EXAMPLE USAGE
# GL-gen-processed-metagenomics-readme --output-name Post_Processing/README.txt --protocol-id GL-DPPD-7116 --runsheet PE_file.csv --technology illumina --sample-type low_biomass --assay-suffix ''  --glds-id OSD-944

parser = argparse.ArgumentParser(
    description="This program generates the corresponding README file for GeneLab processed metagenomics datasets. It is intended to \
                                             be run before running `GL-validate-processed-metagenomics-data` and after processing_info.zip has been created.")

required = parser.add_argument_group('required arguments')
required.add_argument("--glds-id", "--osd-id", help='GLDS or OSDR ID (e.g. "GLDS-69" or "OSD-69")', action="store", required=True)

parser.add_argument("--output", "--output-name", default="README.txt",
                    help='Name of output file (default: "README.txt")')
parser.add_argument("--name", default="Olabiyi A. Obayomi",
                    help='Name of individual who performed the processing (default: "Olabiyi A. Obayomi")')
parser.add_argument("--email", default="olabiyi.a.obayomi@nasa.gov",
                    help='Email address of individual who performed the processing (default: "olabiyi.a.obayomi@nasa.gov")')
parser.add_argument("--protocol-id", default="GL-DPPD-7116",
                    help='Protocol document ID followed (default: "GL-DPPD-7116")')
parser.add_argument("--runsheet", default="PE_file.csv",
                    help='Runsheet file name (default: "PE_file.csv")')
parser.add_argument("--technology", default="illumina",
                    help='Technology used for sequencing. One of "illumina" or "nanopore" (default: "illumina")')
parser.add_argument("--sample-type", default="low_biomass",
                    help='Sample type sequenced. One of "low_biomass" or "standard" (default: "low_biomass")')
parser.add_argument("--host-removed", default=False, action="store_true",
                    help='Indicates if host sequences were removed from the dataset (default: False)')
parser.add_argument("-p", "--output-prefix", help="Output additional file prefix if there is one", action="store", default="")
parser.add_argument("--assay-suffix", help="GeneLab assay suffix. one of '_GLmetagenomics', '_GLlbsMetag', '_GLlblMetag', and '_GLlongMetag'", action="store", default="")
parser.add_argument("--date", action="store", default=datetime.date.today(), type=datetime.date.fromisoformat,
                    help="Date the processed data was generated in ISO format (YYYY-MM-DD). (default: today's date)")

if len(sys.argv) == 1:
    parser.print_help(sys.stderr)
    sys.exit(0)

args = parser.parse_args()

################################################################################

def main():
    with open(args.output, "w") as output:
        write_header(output, args.glds_id, args.name, args.email, args.protocol_id, args.date)
        write_metagenomics_body(output)

################################################################################

def write_header(output, glds_id, name, email, protocol_id, date):
    # Support both GLDS and OSD prefixes
    url_base = "https://osdr.nasa.gov/bio/repo/data/studies/" if glds_id.startswith("OSD-") else "https://genelab-data.ndc.nasa.gov/genelab/accession/"
    
    header = ["################################################################################\n",
              "{:<77} {:>0}".format(f"## This directory holds processed data for NASA {glds_id}", "##\n"),
              "{:<77} {:>0}".format(f"## {url_base}{glds_id}/", "##\n"),
              "{:<77} {:>0}".format("##", "##\n"),
              "{:<77} {:>0}".format(f"## Processed by {name} ({email}) on {date}", "##\n"),
              "{:<77} {:>0}".format(f"## Based on {protocol_id}", "##\n"),
              "################################################################################\n\n",
              "Summary of contents:\n\n"]

    output.writelines(header)

def add_level(file_name, file_description, max_offset, output, continues, is_last=False):
    indent_parts = ["   "]
    for cont in continues[:-1]:
        indent_parts.append("│   " if cont else "    ")
    
    connector = "└──" if is_last else "├──"
    indent_parts.append(connector)
    prefix = "".join(indent_parts)
    spacing = max(1, max_offset - len(prefix))

    if file_description == "":
        output.write(f"{prefix} {file_name:<{spacing}}\n")
    else:
        output.write(f"{prefix} {file_name:<{spacing}}   - {file_description}\n")

def add_spacer(output):
    output.write("   │\n")

def write_metagenomics_body(output):

    prefix = args.output_prefix
    if prefix != '' and not prefix.endswith('_'):
        prefix = f"{prefix}_"

    # Calculate padding based on a long representative filename
    longest_filename = f"{args.output_prefix}Combined-gene-level-KO-function_unfiltered_top_50_heatmap{args.assay_suffix}.png"
    pad = len(longest_filename) + (6 * 4) + 2

    # Root Level
    add_level(args.output, "this file", pad, output, continues=[True])
    add_spacer(output)

    isNanopore = True if args.technology == "nanopore" else False
    step_prefix = "raw" if isNanopore else "HRrm"
    step = "raw" if isNanopore else "human read removed"
    # Sequence Data Sections
    add_level("Merged_Sequence_Data/", "raw data", pad, output, continues=[True])
    add_level("MultiQC_Reports/", "raw data MultiQC summary reports", pad, output, continues=[True, True], is_last=not isNanopore)
    add_level(f"{prefix}{step_prefix}_multiqc{args.assay_suffix}.html", f"{step} data MultiQC summary report", pad, output, continues=[True, isNanopore, True])
    add_level(f"{prefix}{step_prefix}_multiqc{args.assay_suffix}_data.zip", f"{step} data MultiQC data files", pad, output, continues=[True, isNanopore, True], is_last=True)
    if args.technology == "nanopore":
        add_level("NanoPlots/", "NanoPlot report for raw sample data", pad, output, continues=[True, True], is_last=True)
        add_level(f"{prefix}*_{step_prefix}_NanoPlot-report{args.assay_suffix}.html", f"NanoPlot html summary for {step} sample data", pad, output, continues=[True, False, True], is_last=True)
    add_spacer(output)

    add_level("Filtered_Sequence_Data/", "quality-filtered data", pad, output, continues=[True])
    if args.technology == "illumina":
        add_level(f"{prefix}*filtered{args.assay_suffix}.fastq.gz", "fastq files that have been quality filtered, adapter trimmed and human reads removed", pad, output, continues=[True, True])
    add_level("MultiQC_Reports/", "filtered data MultiQC summary reports", pad, output, continues=[True, True], is_last=not isNanopore)
    add_level(f"{prefix}filtered_multiqc{args.assay_suffix}.html", "filtered data MultiQC summary report", pad, output, continues=[True, isNanopore, True])
    add_level(f"{prefix}filtered_multiqc{args.assay_suffix}_data.zip", "filtered data MultiQC data files", pad, output, continues=[True, isNanopore, True], is_last=True)
    if args.technology == "nanopore":
        add_level("NanoPlots/", "NanoPlot report for filtered sample data", pad, output, continues=[True, True], is_last=True)
        add_level(f"{prefix}*_filtered_NanoPlot-report{args.assay_suffix}.html", "NanoPlot html summary for filtered sample data", pad, output, continues=[True, False, True], is_last=True)
    add_spacer(output)

    if args.technology == "nanopore":
        add_level("Trimmed_Sequence_Data/", "adapter trimmed data", pad, output, continues=[True])
        add_level("MultiQC_Reports/", "trimmed data MultiQC summary reports", pad, output, continues=[True, True], is_last=not isNanopore)
        add_level(f"{prefix}trimmed_multiqc{args.assay_suffix}.html", "trimmed data MultiQC summary report", pad, output, continues=[True, True, True])
        add_level(f"{prefix}trimmed_multiqc{args.assay_suffix}_data.zip", "trimmed data MultiQC data files", pad, output, continues=[True, True, True], is_last=True)
        add_level("NanoPlots/", "NanoPlot report for trimmed sample data", pad, output, continues=[True, True], is_last=True)
        add_level(f"{prefix}*_trimmed_NanoPlot-report{args.assay_suffix}.html", "NanoPlot html summary for trimmed sample data", pad, output, continues=[True, False, True], is_last=True)
        add_spacer(output)

    add_level("HR-removed_Sequence_Data/", "data after human read removal", pad, output, continues=[True])
    add_level(f"{prefix}*_HRrm{args.assay_suffix}.fastq.gz", "fastq files that have been filtered and trimmed and had blank and human reads removed", pad, output, continues=[True, True])
    add_level("MultiQC_Reports/", "human read removed data MultiQC summary reports", pad, output, continues=[True, True], is_last=not isNanopore)
    add_level(f"{prefix}HRrm_multiqc{args.assay_suffix}.html", "MultiQC summary report for samples with human reads removed", pad, output, continues=[True, isNanopore, True])
    add_level(f"{prefix}HRrm_multiqc{args.assay_suffix}_data.zip", "MultiQC data for samples with human reads removed", pad, output, continues=[True, isNanopore, True], is_last=True)
    if args.technology == "nanopore":
        add_level("NanoPlots/", "NanoPlot report for human read removed sample data", pad, output, continues=[True, True], is_last=True)
        add_level(f"{prefix}*_HRrm{args.assay_suffix}_NanoPlot-report{args.assay_suffix}.html", "NanoPlot html summary for decontaminated sample data", pad, output, continues=[True, False, True], is_last=True)    
    add_spacer(output)    

    if args.sample_type == "low_biomass":
        add_level("Decontaminated_Sequence_Data/", "data after blank removal", pad, output, continues=[True])
        add_level(f"{prefix}*_decontam{args.assay_suffix}.fastq.gz", "fastq files that have been filtered and trimmed and had blank reads removed", pad, output, continues=[True, True])
        add_level("MultiQC_Reports/", "decontaminated data MultiQC summary reports", pad, output, continues=[True, True], is_last=not isNanopore)
        add_level(f"{prefix}decontam_multiqc{args.assay_suffix}.html", "MultiQC summary report for samples with blanks removed", pad, output, continues=[True, isNanopore, True])
        add_level(f"{prefix}decontam_multiqc{args.assay_suffix}_data.zip", "MultiQC data for samples with blanks removed", pad, output, continues=[True, isNanopore, True], is_last=True)
        if args.technology == "nanopore":
            add_level("NanoPlots/", "NanoPlot report for decontaminated sample data", pad, output, continues=[True, True], is_last=True)
            add_level(f"{prefix}*_decontam{args.assay_suffix}_NanoPlot-report{args.assay_suffix}.html", "NanoPlot html summary for decontaminated sample data", pad, output, continues=[True, False, True], is_last=True)    
        add_spacer(output)

    if args.host_removed:
        add_level("HostRm-removed_Sequence_Data/", "data after host read removal", pad, output, continues=[True])
        add_level(f"{prefix}*_HostRm{args.assay_suffix}.fastq.gz", "fastq files that have been filtered and trimmed and had blank, human and host reads removed", pad, output, continues=[True, True])
        add_level("MultiQC_Reports/", "host read removed data MultiQC summary reports", pad, output, continues=[True, True])
        add_level(f"{prefix}HostRm_multiqc{args.assay_suffix}.html", "MultiQC summary report for samples with host reads removed", pad, output, continues=[True, isNanopore, True])
        add_level(f"{prefix}HostRm_multiqc{args.assay_suffix}_data.zip", "MultiQC data for samples with host reads removed", pad, output, continues=[True, isNanopore, True], is_last=True)
        if args.technology == "nanopore":
            add_level("NanoPlots/", "NanoPlot report for host read removed sample data", pad, output, continues=[True, True], is_last=True)
            add_level(f"{prefix}*_HostRm{args.assay_suffix}_NanoPlot-report{args.assay_suffix}.html", "NanoPlot html summary for host read removed sample data", pad, output, continues=[True, False, True], is_last=True)    
        add_spacer(output)

    # Assembly-based Processing
    add_level("Assembly-based_Processing/", "results generated from assembly-based approach", pad, output, continues=[True])
    add_level(f"{prefix}Assembly-based-processing-overview{args.assay_suffix}.tsv", "summary overview of assembly-based processing", pad, output, continues=[True, True])
    
    # Annotations and Taxonomy
    add_level("annotations-and-taxonomy/", "functional and taxonomic annotations for contigs and genes", pad, output, continues=[True, True])
    add_level(f"{prefix}*-contig-coverage-and-tax{args.assay_suffix}.tsv", "contig-level coverage and taxonomy", pad, output, continues=[True, True, True])
    add_level(f"{prefix}*-gene-coverage-annotation-and-tax{args.assay_suffix}.tsv", "gene-level coverage, annotation, and taxonomy", pad, output, continues=[True, True, True], is_last=True)

    # Assemblies
    add_level("assemblies/", "per-sample assembly files", pad, output, continues=[True, True])
    add_level(f"{prefix}*-assembly{args.assay_suffix}.fasta", "assembled contigs in fasta format", pad, output, continues=[True, True, True])
    add_level(f"{prefix}Failed-assemblies{args.assay_suffix}.tsv", "samples that didn't assemble any contigs (if any)", pad, output, continues=[True, True, True])
    add_level(f"{prefix}assembly-summaries{args.assay_suffix}.tsv", "summary stats for all assemblies", pad, output, continues=[True, True, True], is_last=True)

    # Bins
    add_level("bins/", "genomic bins recovered from assemblies", pad, output, continues=[True, True])
    add_level(f"{prefix}*-bins{args.assay_suffix}.zip", "fasta files for genomic bins", pad, output, continues=[True, True, True])
    add_level(f"{prefix}bins-overview{args.assay_suffix}.tsv", "summary statistics for genomic bins", pad, output, continues=[True, True, True], is_last=True)

    # Combined Outputs
    add_level("combined-outputs -", "summary outputs with all samples combined", pad, output, continues=[True, True])

    add_level("Contig-level -", "combined contig-level taxonomy data", pad, output, continues=[True, True, True])
    add_level(f"{prefix}Combined-contig-level-taxonomy-coverages-CPM{args.assay_suffix}.tsv", "combined contig-level taxonomy coverages normalized to copies per million", pad, output, continues=[True, True, True, True])
    add_level(f"{prefix}Combined-contig-level-taxonomy-coverages{args.assay_suffix}.tsv", "combined contig-level taxonomy coverages", pad, output, continues=[True, True, True, True])
 
    add_level("Counts_Tables/", "combined contig-level taxonomy count tables", pad, output, continues=[True, True, True, True])
    add_level(f"{prefix}Combined-contig-level-taxonomy_filtered{args.assay_suffix}.tsv", "filtered contig-level taxonomy table", pad, output, continues=[True, True, True, True, True], is_last=not isNanopore)
    if args.sample_type == "low_biomass":
        add_level(f"{prefix}Combined-contig-level-taxonomy_decontam_results{args.assay_suffix}.tsv", "decontam results for contig-level taxonomy data", pad, output, continues=[True, True, True, True, True], is_last=True)

    add_level("Heatmaps/", "combined contig-level taxonomy heatmaps", pad, output, continues=[True, True, True, True], is_last=True)    
    add_level(f"{prefix}Combined-contig-level-taxonomy_unfiltered_heatmap{args.assay_suffix}.png", "heatmap of unfiltered contig-level taxonomy data", pad, output, continues=[True, True, True, False, True])
    add_level(f"{prefix}Combined-contig-level-taxonomy_unfiltered_top_50_heatmap{args.assay_suffix}.png", "top 50 heatmap of unfiltered contig-level taxonomy data", pad, output, continues=[True, True, True, False, True])
    add_level(f"{prefix}Combined-contig-level-taxonomy_filtered_heatmap{args.assay_suffix}.png", "heatmap of filtered contig-level taxonomy data", pad, output, continues=[True, True, True, False, True])
    add_level(f"{prefix}Combined-contig-level-taxonomy_filtered_top_50_heatmap{args.assay_suffix}.png", "top 50 heatmap of filtered contig-level taxonomy data", pad, output, continues=[True, True, True, False, True], is_last= not isNanopore)
    if args.sample_type == "low_biomass":
        add_level(f"{prefix}Combined-contig-level-taxonomy_decontam_heatmap{args.assay_suffix}.png", "heatmap of decontam results for contig-level taxonomy data", pad, output, continues=[True, True, True, False, True])
        add_level(f"{prefix}Combined-contig-level-taxonomy_decontam_top_50_heatmap{args.assay_suffix}.png", "top 50 heatmap of decontam results for contig-level taxonomy data", pad, output, continues=[True, True, True, False, True], is_last=True)

    add_level("Gene-level -", "combined gene-level data", pad, output, continues=[True, True, True], is_last=True)
    add_level("KO -", "Kegg Orthology functional data", pad, output, continues=[True, True, False, True])
    add_level(f"{prefix}Combined-gene-level-KO-function-coverages-CPM{args.assay_suffix}.tsv", "combined gene-level KO-function coverages normalized to copies per million", pad, output, continues=[True, True, False, True, True])
    add_level(f"{prefix}Combined-gene-level-KO-function-coverages{args.assay_suffix}.tsv", "combined gene-level KO-function coverages", pad, output, continues=[True, True, False, True, True])
    add_level(f"{prefix}Combined-gene-level-KO-function{args.assay_suffix}.tsv", "combined gene-level KO-function data", pad, output, continues=[True, True, False, True, True])
    add_level("Counts_Tables/", "combined gene-level KO-function count tables", pad, output, continues=[True, True, False, True, True])
    add_level(f"{prefix}Combined-gene-level-KO-function_filtered{args.assay_suffix}.tsv", "filtered gene-level KO-function table", pad, output, continues=[True, True, False, True, True, True], is_last=not isNanopore)
    if args.sample_type == "low_biomass":
        add_level(f"{prefix}Combined-gene-level-KO-function_decontam{args.assay_suffix}.tsv", "decontam results for gene-level KO-function data", pad, output, continues=[True, True, False, True, True, True], is_last=True)

    add_level("Heatmaps/", "combined gene-level KO-function heatmaps", pad, output, continues=[True, True, False, True, True], is_last=True)
    add_level(f"{prefix}Combined-gene-level-KO-function_unfiltered_heatmap{args.assay_suffix}.png", "heatmap of unfiltered gene-level KO-function data", pad, output, continues=[True, True, False, True, False, True])
    add_level(f"{prefix}Combined-gene-level-KO-function_unfiltered_top_50_heatmap{args.assay_suffix}.png", "top 50 heatmap of unfiltered gene-level KO-function data", pad, output, continues=[True, True, False, True, False, True])
    add_level(f"{prefix}Combined-gene-level-KO-function_filtered_heatmap{args.assay_suffix}.png", "heatmap of filtered gene-level KO-function data", pad, output, continues=[True, True, False, True, False, True])
    add_level(f"{prefix}Combined-gene-level-KO-function_filtered_top_50_heatmap{args.assay_suffix}.png", "top 50 heatmap of filtered gene-level KO-function data", pad, output, continues=[True, True, False, True, False, True], is_last=not isNanopore)
    if args.sample_type == "low_biomass":
        add_level(f"{prefix}Combined-gene-level-KO-function_decontam_heatmap{args.assay_suffix}.png", "heatmap of decontam results for gene-level KO-function data", pad, output, continues=[True, True, False, True, False, True])
        add_level(f"{prefix}Combined-gene-level-KO-function_decontam_top_50_heatmap{args.assay_suffix}.png", "top 50 heatmap of decontam results for gene-level KO-function data", pad, output, continues=[True, True, False, True, False, True], is_last=True)

    add_level("Taxonomy -", "gene-level taxonomy data", pad, output, continues=[True, True, False, True], is_last=True)
    add_level(f"{prefix}Combined-gene-level-taxonomy-coverages-CPM{args.assay_suffix}.tsv", "combined gene-level taxonomy coverages normalized to copies per million", pad, output, continues=[True, True, False, False, True])
    add_level(f"{prefix}Combined-gene-level-taxonomy-coverages{args.assay_suffix}.tsv", "combined gene-level taxonomy coverages", pad, output, continues=[True, True, False, False, True])
    add_level(f"{prefix}Combined-gene-level-taxonomy{args.assay_suffix}.tsv", "combined gene-level taxonomy data", pad, output, continues=[True, True, False, False, True])
    add_level("Counts_Tables/", "combined gene-level taxonomy count tables", pad, output, continues=[True, True, False, False, True])
    add_level(f"{prefix}Combined-gene-level-taxonomy_filtered{args.assay_suffix}.tsv", "filtered gene-level taxonomy table", pad, output, continues=[True, True, False, False, True, True], is_last=not isNanopore)
    if args.sample_type == "low_biomass":
        add_level(f"{prefix}Combined-gene-level-taxonomy_decontam_results{args.assay_suffix}.tsv", "decontam results for gene-level taxonomy data", pad, output, continues=[True, True, False, False, True, True], is_last=True)
    add_level("Heatmaps/", "combined gene-level taxonomy heatmaps", pad, output, continues=[True, True, False, False, True], is_last=True)
    add_level(f"{prefix}Combined-gene-level-taxonomy_unfiltered_heatmap{args.assay_suffix}.png", "heatmap of unfiltered gene-level taxonomy data", pad, output, continues=[True, True, False, False, False, True])
    add_level(f"{prefix}Combined-gene-level-taxonomy_unfiltered_top_50_heatmap{args.assay_suffix}.png", "heatmap of unfiltered gene-level taxonomy data", pad, output, continues=[True, True, False, False, False, True])
    add_level(f"{prefix}Combined-gene-level-taxonomy_filtered_heatmap{args.assay_suffix}.png", "heatmap of filtered gene-level taxonomy data", pad, output, continues=[True, True, False, False, False, True])
    add_level(f"{prefix}Combined-gene-level-taxonomy_filtered_top_50_heatmap{args.assay_suffix}.png", "top 50 heatmap of filtered gene-level taxonomy data", pad, output, continues=[True, True, False, False, False, True], is_last=not isNanopore)
    if args.sample_type == "low_biomass":
        add_level(f"{prefix}Combined-gene-level-taxonomy_decontam_heatmap{args.assay_suffix}.png", "heatmap of decontam results for gene-level taxonomy data", pad, output, continues=[True, True, False, False, False, True])
        add_level(f"{prefix}Combined-gene-level-taxonomy_decontam_top_50_heatmap{args.assay_suffix}.png", "top 50 heatmap of decontam results for gene-level taxonomy data", pad, output, continues=[True, True, False, False, False, True], is_last=True)

    # MAGs
    add_level("MAGs -", "metagenome-assembled genomes (MAGs) and associated data", pad, output, continues=[True, True])
    add_level(f"{prefix}*-MAGs{args.assay_suffix}.zip", "fasta files for all recovered MAGs", pad, output, continues=[True, True, True])
    add_level(f"{prefix}MAGs-overview{args.assay_suffix}.tsv", "summary statistics for all recovered MAGs", pad, output, continues=[True, True, True])
    add_level("KEGG_Outputs/", "functional annotations for MAGs", pad, output, continues=[True, True, True], is_last=True)
    add_level(f"{prefix}MAG-KEGG-Decoder-out{args.assay_suffix}.tsv", "KEGG Decoder metabolic pathway summary table", pad, output, continues=[True, True, False, True])
    add_level(f"{prefix}MAG-KEGG-Decoder-out{args.assay_suffix}.html", "KEGG Decoder metabolic pathway summary html", pad, output, continues=[True, True, False, True])
    add_level(f"{prefix}MAG-level-KO-annotations{args.assay_suffix}.tsv", "KO term annotations for each MAG", pad, output, continues=[True, True, False, True], is_last=True)

    # Predicted Genes
    add_level("predicted-genes/", "per-sample gene predictions", pad, output, continues=[True, True])
    add_level(f"{prefix}*-genes{args.assay_suffix}.faa", "protein sequences of predicted genes", pad, output, continues=[True, True, True])
    add_level(f"{prefix}*-genes{args.assay_suffix}.fasta", "nucleotide sequences of predicted genes", pad, output, continues=[True, True, True])
    add_level(f"{prefix}*-genes{args.assay_suffix}.gff", "coordinates of predicted genes", pad, output, continues=[True, True, True], is_last=True)

    # Read Mapping
    add_level("read-mapping/", "alignment of reads back to assemblies", pad, output, continues=[True, True], is_last=True)
    add_level(f"{prefix}*{args.assay_suffix}.bam", "binary alignment files", pad, output, continues=[True, False, True])
    add_level(f"{prefix}*-mapping-info{args.assay_suffix}.txt", "alignment summary statistics", pad, output, continues=[True, False, True])
    add_level(f"{prefix}*-metabat-assembly-depth{args.assay_suffix}.tsv", "contig depth for binning", pad, output, continues=[True, False, True], is_last=True)

    add_spacer(output)


    # Read-based Processing 
    add_level("Read-based_Processing/", "taxonomic profiling results", pad, output, continues=[True])

    add_level("Humann_Outputs -", "Humann functional profiling", pad, output, continues=[True, True])
    add_level("Gene_Families -", "Gene families", pad, output, continues=[True, True, True])
    add_level(f"{prefix}Gene-families{args.assay_suffix}.tsv", "raw gene-family abundance table", pad, output, continues=[True, True, True, True])
    add_level(f"{prefix}Gene-families-cpm{args.assay_suffix}.tsv", "gene-family abundances normalized to copies-per-million", pad, output, continues=[True, True, True, True])
    add_level(f"{prefix}Gene-families-grouped-by-taxa{args.assay_suffix}.tsv", "gene-family abundances grouped by taxa", pad, output, continues=[True, True, True, True])
    
    add_level("Counts_Tables/", "uniref gene families count tables", pad, output, continues=[True, True, True, True])
    add_level(f"{prefix}Gene-families-uniref_filtered{args.assay_suffix}.tsv", "filtered uniref gene-family abundances", pad, output, continues=[True, True, True, True, True], is_last=not isNanopore)
    if args.sample_type == "low_biomass":
        add_level(f"{prefix}Gene-families-uniref_decontam_table{args.assay_suffix}.tsv", "decontaminated uniref gene-family abundances", pad, output, continues=[True, True, True, True, True])
        add_level(f"{prefix}Gene-families-uniref_decontam_results{args.assay_suffix}.tsv", "decontamination results for uniref gene families", pad, output, continues=[True, True, True, True, True], is_last=True)
    
    add_level("Heatmaps/", "uniref gene families heatmaps", pad, output, continues=[True, True, True, True])
    add_level(f"{prefix}Gene-families-uniref_unfiltered_heatmap{args.assay_suffix}.png", "heatmap of unfiltered gene-family abundances", pad, output, continues=[True, True, True, True, True])
    add_level(f"{prefix}Gene-families-uniref_unfiltered_top_50_heatmap{args.assay_suffix}.png", "top 50 gene families heatmap", pad, output, continues=[True, True, True, True, True])
    add_level(f"{prefix}Gene-families-uniref_filtered_heatmap{args.assay_suffix}.png", "filtered heatmap of gene-family abundances", pad, output, continues=[True, True, True, True, True])
    add_level(f"{prefix}Gene-families-uniref_filtered_top_50_heatmap{args.assay_suffix}.png", "top 50 gene families heatmap", pad, output, continues=[True, True, True, True, True], is_last=not isNanopore)
    if args.sample_type == "low_biomass":
        add_level(f"{prefix}Gene-families-uniref_decontam_heatmap{args.assay_suffix}.png", "heatmap of decontaminated uniref gene-family abundances", pad, output, continues=[True, True, True, True, True])
        add_level(f"{prefix}Gene-families-uniref_decontam_top_50_heatmap{args.assay_suffix}.png", "top 50 uniref gene families heatmap after decontamination", pad, output, continues=[True, True, True, True, True], is_last=True)

    add_level("KO -", "KO term abundances", pad, output, continues=[True, True, True, True], is_last=True)
    add_level(f"{prefix}Gene-families-KO{args.assay_suffix}.tsv", "KO term abundances", pad, output, continues=[True, True, True, False, True])
    add_level(f"{prefix}Gene-families-KO-cpm{args.assay_suffix}.tsv", "KO term abundances normalized to copies-per-million", pad, output, continues=[True, True, True, False, True])    
    add_level("Counts_Tables/", "KO term abundances table", pad, output, continues=[True, True, True, False, True])
    add_level(f"{prefix}Gene-families-KO_filtered{args.assay_suffix}.tsv", "filtered KO term abundances", pad, output, continues=[True, True, True, False, True, True], is_last=not isNanopore)
    if args.sample_type == "low_biomass":
        add_level(f"{prefix}Gene-families-KO_decontam_table{args.assay_suffix}.tsv", "decontaminated KO term abundances", pad, output, continues=[True, True, True, False, True, True])
        add_level(f"{prefix}Gene-families-KO_decontam_results{args.assay_suffix}.tsv", "decontamination results for KO terms", pad, output, continues=[True, True, True, False, True, True], is_last=True)
    add_level("Heatmaps/", "KO term abundances", pad, output, continues=[True, True, True, False, True], is_last=True)
    if args.sample_type == "low_biomass":
        add_level(f"{prefix}Gene-families-KO_decontam_heatmap{args.assay_suffix}.png", "heatmap of decontaminated KO term abundances", pad, output, continues=[True, True, True, False, False, True])
        add_level(f"{prefix}Gene-families-KO_decontam_top_50_heatmap{args.assay_suffix}.png", "top 50 KO terms heatmap after decontamination", pad, output, continues=[True, True, True, False, False, True])
    add_level(f"{prefix}Gene-families-KO_filtered_heatmap{args.assay_suffix}.png", "heatmap of filtered KO term abundances", pad, output, continues=[True, True, True, False, False, True])
    add_level(f"{prefix}Gene-families-KO_filtered_top_50_heatmap{args.assay_suffix}.png", "top 50 KO terms heatmap", pad, output, continues=[True, True, True, False, False, True])
    add_level(f"{prefix}Gene-families-KO_unfiltered_heatmap{args.assay_suffix}.png", "heatmap of unfiltered KO term abundances", pad, output, continues=[True, True, True, False, False, True])
    add_level(f"{prefix}Gene-families-KO_unfiltered_top_50_heatmap{args.assay_suffix}.png", "top 50 KO terms heatmap", pad, output, continues=[True, True, True, False, False, True], is_last=True)



    add_level("Pathway_abundances/", "Pathway abundances", pad, output, continues=[True, True, True])
    add_level(f"{prefix}Pathway-abundances-cpm{args.assay_suffix}.tsv", "pathway abundances normalized to copies-per-million", pad, output, continues=[True, True, True, True])
    add_level(f"{prefix}Pathway-abundances-grouped-by-taxa{args.assay_suffix}.tsv", "pathway abundances grouped by taxa", pad, output, continues=[True, True, True, True])
    add_level(f"{prefix}Pathway-abundances{args.assay_suffix}.tsv", "raw pathway abundance table", pad, output, continues=[True, True, True, True])
    add_level("Counts_Tables/", "pathway abundances count tables", pad, output, continues=[True, True, True, True])
    add_level(f"{prefix}Pathway-abundances_filtered{args.assay_suffix}.tsv", "filtered pathway abundance table", pad, output, continues=[True, True, True, True, True], is_last=not isNanopore)
    if args.sample_type == "low_biomass":
        add_level(f"{prefix}Pathway-abundances_decontam_table{args.assay_suffix}.tsv", "decontaminated pathways abundance table", pad, output, continues=[True, True, True, True, True])
        add_level(f"{prefix}Pathway-abundances_decontam_results{args.assay_suffix}.tsv", "decontam results for pathway abundances", pad, output, continues=[True, True, True, True, True], is_last=True)

    add_level("Heatmaps/", "pathways heatmaps", pad, output, continues=[True, True, True, True], is_last=True)
    add_level(f"{prefix}Pathway-abundances_unfiltered_heatmap{args.assay_suffix}.png", "heatmap of unfiltered pathway abundances", pad, output, continues=[True, True, True, False, True])
    add_level(f"{prefix}Pathway-abundances_unfiltered_top_50_heatmap{args.assay_suffix}.png", "top 50 pathways heatmap", pad, output, continues=[True, True, True, False, True])
    add_level(f"{prefix}Pathway-abundances_filtered_heatmap{args.assay_suffix}.png", "filtered pathways heatmap", pad, output, continues=[True, True, True, False, True], is_last=not isNanopore)
    add_level(f"{prefix}Pathway-abundances_filtered_top_50_heatmap{args.assay_suffix}.png", "top 50 pathways heatmap after filtering", pad, output, continues=[True, True, True, False, True])
    if args.sample_type == "low_biomass":
        add_level(f"{prefix}Pathway-abundances_decontam_heatmap{args.assay_suffix}.png", "heatmap of unfiltered pathway abundances of decontaminated data", pad, output, continues=[True, True, True, False, True])
        add_level(f"{prefix}Pathway-abundances_decontam_top_50_heatmap{args.assay_suffix}.png", "top 50 pathway abundances heatmap of decontaminated data", pad, output, continues=[True, True, True, False, True], is_last=True)

    add_level("Pathway_coverages/", "Pathway coverages", pad, output, continues=[True, True, True], is_last=True)
    add_level(f"{prefix}Pathway-coverages-grouped-by-taxa{args.assay_suffix}.tsv", "pathway coverages grouped by taxa", pad, output, continues=[True, True, False, True])
    add_level(f"{prefix}Pathway-coverages{args.assay_suffix}.tsv", "pathway coverages", pad, output, continues=[True, True, False, True], is_last=True)

    tools = ["Kaiju", "Kraken2", "Metaphlan"] if args.technology == "illumina" else ["Kaiju", "Kraken2"]
    for tool in tools:
        is_tool_last = (tool == "Metaphlan") if args.technology == "illumina" else (tool == "Kraken2")
        add_level(f"{tool}_Outputs -", f"{tool} taxonomic profiling", pad, output, continues=[True, not is_tool_last], is_last=is_tool_last)
        if tool == "Kraken2":
            add_level("MultiQC_Reports -", "Kraken2 MultiQC summary reports", pad, output, continues=[True, not isNanopore, True])
            add_level(f"{prefix}kraken2_multiqc{args.assay_suffix}.html", "MultiQC summary report for kraken2 classification", pad, output, continues=[True, not isNanopore, True, True])
            add_level(f"{prefix}kraken2_multiqc{args.assay_suffix}_data.zip", "MultiQC data for kraken2 classification", pad, output, continues=[True, not isNanopore, True, True], is_last=True)
        add_level("Barplots/", "visualizations of taxonomic relative abundance", pad, output, continues=[True, not is_tool_last, True])
        add_level(f"{prefix}{tool.lower()}_unfiltered_species_barplot{args.assay_suffix}.html", f"{tool} unfiltered species html barplot", pad, output, continues=[True, not is_tool_last, True, True], is_last=not isNanopore)
        add_level(f"{prefix}{tool.lower()}_filtered_species_barplot{args.assay_suffix}.html", f"{tool} filtered species html barplot", pad, output, continues=[True, not is_tool_last, True, True])
        if args.sample_type == "low_biomass":
            add_level(f"{prefix}{tool.lower()}_decontam_species_barplot{args.assay_suffix}.html", f"{tool} decontaminated species html barplot", pad, output, continues=[True, not is_tool_last, True, True], is_last=True)
        if tool == "Metaphlan":
            add_level(f"{prefix}Metaphlan-taxonomy{args.assay_suffix}.tsv", "Metaphlan estimated taxonomic relative abundances", pad, output, continues=[True, not is_tool_last, True, True])
        add_level("Counts_Tables/", "species relative abundance tables", pad, output, continues=[True, not is_tool_last, True])
        add_level(f"{prefix}{tool.lower()}_species_table{args.assay_suffix}.tsv", f"{tool} raw species table", pad, output, continues=[True, not is_tool_last, True, True], is_last=True)
        add_level(f"{prefix}{tool.lower()}_filtered_species_table{args.assay_suffix}.tsv", f"{tool} filtered species table", pad, output, continues=[True, not is_tool_last, True, True], is_last=not isNanopore)
        if args.sample_type == "low_biomass":
            add_level(f"{prefix}{tool.lower()}_decontam_species_table{args.assay_suffix}.tsv", f"{tool} decontaminated species table", pad, output, continues=[True, not is_tool_last, True, True])
            add_level(f"{prefix}{tool.lower()}_decontam_results{args.assay_suffix}.tsv", f"{tool} decontaminated results", pad, output, continues=[True, not is_tool_last, True, True], is_last=True)
        add_level("Krona_Reports -", "interactive hierarchical taxonomy plots", pad, output, continues=[True, not is_tool_last, True], is_last=True)
        add_level(f"{prefix}{tool.lower()}-report{args.assay_suffix}.html", f"Krona plots for {tool} taxonomies", pad, output, continues=[True, not is_tool_last, False, True], is_last=True)
    
    add_spacer(output)

    # Processing Scripts
    add_level(f"processing_info{args.assay_suffix}.zip", "zip archive holding info related to processing", pad, output, continues=[True], is_last=True)
    add_level(f"{args.runsheet}", "runsheet file used to run the workflow", pad, output, continues=[False, True])
    add_level("command.txt", "command-line used to invoke the nextflow workflow", pad, output, continues=[False, True])
    add_level("nextflow_processing_info.txt", "Nextflow log listing all commands executed by the workflow", pad, output, continues=[False, True])
    add_level("software_versions.txt", "list of software versions used", pad, output, continues=[False, True], is_last=True)

    output.write("\n")

if __name__ == "__main__":
    main()
